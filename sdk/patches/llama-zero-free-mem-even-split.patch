diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index d7874e0a9..dd38f57d0 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1354,8 +1354,19 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
         split_sum += splits[i];
         splits[i] = split_sum;
     }
-    for (size_t i = 0; i < n_devices(); ++i) {
-        splits[i] /= split_sum;
+
+    // A device can report 0 free with a non-zero total, so the fallback above
+    // does not fire (OpenCL on an Adreno whose global_mem_size is under its
+    // 1 GiB margin). Normalizing by a zero sum makes every split point NaN, and
+    // the upper_bound below then runs off the end of `devices`.
+    if (split_sum == 0.0f) {
+        for (size_t i = 0; i < n_devices(); ++i) {
+            splits[i] = float(i + 1) / n_devices();
+        }
+    } else {
+        for (size_t i = 0; i < n_devices(); ++i) {
+            splits[i] /= split_sum;
+        }
     }
 
     const int i_gpu_start = std::max(n_layer_all + 1 - n_gpu_layers, 0);
